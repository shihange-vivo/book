<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="general-kernel-evolution" name="8.1-8.2 General-kernel evolution">
    <mxGraphModel dx="1800" dy="980" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="&lt;b&gt;BlueOS 动态加载从 RTOS 向通用内核的演进&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="45" as="geometry"/></mxCell>
      <mxCell id="a" value="&lt;b&gt;阶段 A　当前 RTOS&lt;/b&gt;&lt;br&gt;&lt;br&gt;共享特权地址空间&lt;br&gt;application::thread_group + ApplicationLoader&lt;br&gt;ThreadGroup / ThreadGroupMembership&lt;br&gt;逻辑权限 + 板级 cache backend" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="b" value="&lt;b&gt;阶段 B　受保护 RTOS&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一 ApplicationManager；仍以 ThreadGroup 回收&lt;br&gt;MPU / PMP / MMU 落实 RX/RW/RELRO&lt;br&gt;copy-in/out + opaque handle&lt;br&gt;能力检查成为真实安全边界" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="685" y="110" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="c" value="&lt;b&gt;阶段 C　通用内核进程&lt;/b&gt;&lt;br&gt;&lt;br&gt;Process + AddressSpace + user mode&lt;br&gt;application::process + exec stage0 + ld.so&lt;br&gt;页缓存共享 DSO RX/RO&lt;br&gt;每进程私有 RW/GOT/TLS/ctor" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="eab" value="加强保护，不改变链接语义" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ebc" value="增加 process 与 memory backend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="reuse" value="&lt;b&gt;全阶段持续复用：&lt;/b&gt;标准 ELF / dynamic parser　│　依赖图与 scope　│　psABI relocation　│　init/fini plan　│　ABI note / build-id　│　fixture / oracle" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="365" width="1440" height="65" as="geometry"/></mxCell>
      <mxCell id="st" value="&lt;b&gt;阶段 C 展开：exec + 用户态 ld.so 启动流程&lt;/b&gt;" style="text;html=1;align=left;fontSize=21;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="70" y="475" width="800" height="38" as="geometry"/></mxCell>
      <mxCell id="s1" value="&lt;b&gt;① exec 准入&lt;/b&gt;&lt;br&gt;校验包和主 ELF&lt;br&gt;创建未发布 Process / AS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="65" y="545" width="265" height="115" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;② stage0 映射&lt;/b&gt;&lt;br&gt;只映射 main + PT_INTERP&lt;br&gt;构造 argc/argv/envp/auxv&lt;br&gt;initial stack" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="545" width="265" height="115" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;③ 进入用户态 ld.so&lt;/b&gt;&lt;br&gt;read / pread&lt;br&gt;mmap / mprotect / munmap&lt;br&gt;进程内 resolver" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="635" y="545" width="265" height="115" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;④ 完成动态链接&lt;/b&gt;&lt;br&gt;dependency → scope → NOW reloc&lt;br&gt;RELRO / cache sync&lt;br&gt;发布 per-process LinkMap" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="545" width="295" height="115" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;⑤ 运行应用&lt;/b&gt;&lt;br&gt;依赖优先 ctor&lt;br&gt;跳转主程序入口 / main" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1235" y="545" width="230" height="115" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;⑥ 进程退出&lt;/b&gt;&lt;br&gt;逆序 fini&lt;br&gt;kernel 回收整个地址空间" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1485" y="545" width="250" height="115" as="geometry"/></mxCell>
      <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="kernel" value="&lt;b&gt;内核职责&lt;/b&gt;&lt;br&gt;1–2：可信启动、地址空间和用户态入口；6：整体回收" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="735" width="550" height="80" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;用户态 ld.so / libc 职责&lt;/b&gt;&lt;br&gt;3–5：普通 DSO 图、符号绑定、relocation、构造与进入 main" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="735" width="650" height="80" as="geometry"/></mxCell>
      <mxCell id="n" value="阶段 B 先验证保护和地址边界；阶段 C 才启用 Process、Linux 风格 initial stack 与 PT_INTERP。lazy binding 仍不是必选项。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEFCE8;strokeColor=#EAB308;fontColor=#713F12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="875" width="1120" height="48" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
