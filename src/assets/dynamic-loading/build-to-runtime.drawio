<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="build-to-runtime" name="1.2 Build to runtime">
    <mxGraphModel dx="1600" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;从编译到运行：静态链接器与运行时链接器的接力&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="45" as="geometry"/></mxCell>
        <mxCell id="build-zone" value="&lt;b&gt;构建期&lt;/b&gt;" style="rounded=1;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontSize=18;fontColor=#1E3A8A;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="980" height="500" as="geometry"/></mxCell>
        <mxCell id="run-zone" value="&lt;b&gt;运行期&lt;/b&gt;" style="rounded=1;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=2;fontSize=18;fontColor=#166534;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1045" y="95" width="515" height="500" as="geometry"/></mxCell>
        <mxCell id="source" value="&lt;b&gt;Rust / C 源码&lt;/b&gt;&lt;br&gt;应用、libfoo、librs_swi" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="78" y="190" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="compiler" value="&lt;b&gt;compiler&lt;/b&gt;&lt;br&gt;PIC 编译&lt;br&gt;保留未定义外部引用" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="335" y="180" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="objects" value="&lt;b&gt;ET_REL .o / rlib&lt;/b&gt;&lt;br&gt;sections · symbols · relocation&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;尚未形成发布 ABI&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="590" y="180" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="static-linker" value="&lt;b&gt;static linker&lt;/b&gt;&lt;br&gt;合并 section&lt;br&gt;解决镜像内可确定引用&lt;br&gt;保留运行时未知项" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="855" y="170" width="130" height="130" as="geometry"/></mxCell>
        <mxCell id="pie" value="&lt;b&gt;PIE 主程序&lt;/b&gt;&lt;br&gt;ET_DYN + PT_DYNAMIC&lt;br&gt;DT_NEEDED: libc.so.1&lt;br&gt;GOT / PLT / dynamic reloc" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="530" y="380" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="dso" value="&lt;b&gt;共享库 DSO&lt;/b&gt;&lt;br&gt;ET_DYN + DT_SONAME&lt;br&gt;导出动态符号&lt;br&gt;GOT / PLT / dynamic reloc" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="app_loader" value="&lt;b&gt;ApplicationLoader&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;调用 blueos_loader::DynamicLinker&lt;/font&gt;&lt;br&gt;映射 PT_LOAD · DT_NEEDED 依赖闭包&lt;br&gt;scope + relocation&lt;br&gt;RELRO + cache sync" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="405" height="150" as="geometry"/></mxCell>
        <mxCell id="image" value="&lt;b&gt;已绑定运行映像&lt;/b&gt;&lt;br&gt;确定 load bias 与符号地址&lt;br&gt;发布 LinkMap / InitPlan&lt;br&gt;进入 blueos_scrt1 → main" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="405" height="130" as="geometry"/></mxCell>
        <mxCell id="boundary" value="运行时未知项：装载地址、跨 DSO 符号、GOT/PLT 槽" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#9A3412;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="665" height="42" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="source" target="compiler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="compiler" target="objects"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="objects" target="static-linker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="static-linker" target="pie"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="350"/><mxPoint x="640" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="static-linker" target="dso"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="350"/><mxPoint x="885" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.247;entryY=1;" edge="1" parent="1" source="pie" target="app_loader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="520"/><mxPoint x="1080" y="520"/><mxPoint x="1080" y="350"/><mxPoint x="1200" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.733;" edge="1" parent="1" source="dso" target="app_loader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="440"/><mxPoint x="1065" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="app_loader" target="image"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;稳定边界：C ABI&lt;/b&gt;&lt;br&gt;Rust core/alloc/std 首期静态 PIC；不把 Rust dylib ABI 暴露为系统 ABI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="225" y="620" width="1150" height="55" as="geometry"/></mxCell>
