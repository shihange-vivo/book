<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="image-mapping-algorithm" name="7.2.1 Image mapping"><mxGraphModel dx="1800" dy="720" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
  <mxCell id="t" value="&lt;b&gt;单个 ELF image 的安全映射算法&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="45" as="geometry"/></mxCell>
  <mxCell id="s1" value="&lt;b&gt;① 预扫描 PT_LOAD&lt;/b&gt;&lt;br&gt;checked range / span&lt;br&gt;上限 / 对齐 / 权限" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="45" y="155" width="245" height="115" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;② 选址与 reserve&lt;/b&gt;&lt;br&gt;满足 max p_align&lt;br&gt;计算显式 load_bias&lt;br&gt;使用 TargetAddr/TargetWord" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="335" y="145" width="270" height="135" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;③ copy / zero&lt;/b&gt;&lt;br&gt;按 segment 复制 file bytes&lt;br&gt;清 page tail 与 BSS&lt;br&gt;保留逻辑 region 边界" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="650" y="145" width="270" height="135" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;④ relocation 后 seal&lt;/b&gt;&lt;br&gt;写入前逐项 check_range&lt;br&gt;最终 PF_* / RELRO&lt;br&gt;拒绝 W+X" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="965" y="145" width="270" height="135" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;⑤ cache / fence&lt;/b&gt;&lt;br&gt;D-cache clean&lt;br&gt;I-cache invalidate / fence.i" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1280" y="155" width="230" height="115" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;⑥ publish&lt;/b&gt;&lt;br&gt;入口 / 符号 / LinkMap&lt;br&gt;才对其他线程可见" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1555" y="155" width="210" height="115" as="geometry"/></mxCell>
  <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
  <mxCell id="fail" value="&lt;b&gt;任何 prepare / relocate / seal 步骤失败&lt;/b&gt;&lt;br&gt;按逆序 release 临时 allocation 和 region；不得留下半初始化对象，不得运行 ctor。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="385" width="1120" height="75" as="geometry"/></mxCell><mxCell id="fb" value="rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;html=1;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="280" as="sourcePoint"/><mxPoint x="1100" y="385" as="targetPoint"/></mxGeometry></mxCell>
  <mxCell id="flat" value="&lt;b&gt;FlatImageMemory&lt;/b&gt;&lt;br&gt;可用一次连续 RAM allocation，仍保留 RX/RO/RW 逻辑 region" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="235" y="545" width="560" height="70" as="geometry"/></mxCell><mxCell id="protected" value="&lt;b&gt;MPU / PMP / MMU backend&lt;/b&gt;&lt;br&gt;按硬件粒度归并 region，并实际落实 protect；core 算法不变" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1005" y="545" width="560" height="70" as="geometry"/></mxCell>
