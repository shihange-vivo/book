<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="rtos-general-kernel-compatibility" name="5.5 Compatibility design">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="&lt;b&gt;当前 RTOS 与未来通用内核：同一 ApplicationManager，替换执行后端&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="45" as="geometry"/></mxCell>
      <mxCell id="left" value="" style="rounded=1;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="55" y="95" width="640" height="500" as="geometry"/></mxCell><mxCell id="lt" value="&lt;b&gt;当前：RTOS 部署外壳&lt;/b&gt;" style="text;html=1;align=center;fontSize=21;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="80" y="115" width="590" height="38" as="geometry"/></mxCell>
      <mxCell id="am" value="&lt;b&gt;application::thread_group&lt;/b&gt;&lt;br&gt;统一准入 / ThreadGroup / 生命周期" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="175" width="390" height="75" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;kernel ApplicationLoader&lt;/b&gt;&lt;br&gt;驱动 DynamicLinker；拒绝 PT_INTERP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="285" width="390" height="75" as="geometry"/></mxCell><mxCell id="fm" value="&lt;b&gt;FlatImageMemory / MPU backend&lt;/b&gt;&lt;br&gt;同一目标地址空间中的 system DSO instance" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECFEFF;strokeColor=#06B6D4;fontSize=15;" vertex="1" parent="1"><mxGeometry x="130" y="395" width="490" height="85" as="geometry"/></mxCell><mxCell id="th" value="ApplicationStartInfo → RTOS thread" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="210" y="515" width="330" height="50" as="geometry"/></mxCell>
      <mxCell id="right" value="" style="rounded=1;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1105" y="95" width="640" height="500" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;未来：进程部署外壳&lt;/b&gt;" style="text;html=1;align=center;fontSize=21;fontColor=#15803D;" vertex="1" parent="1"><mxGeometry x="1130" y="115" width="590" height="38" as="geometry"/></mxCell>
      <mxCell id="exec" value="&lt;b&gt;application::process / exec stage0&lt;/b&gt;&lt;br&gt;Process / AddressSpace；映射 main + PT_INTERP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1230" y="175" width="390" height="75" as="geometry"/></mxCell><mxCell id="ldso" value="&lt;b&gt;用户态 ld.so&lt;/b&gt;&lt;br&gt;复用 DynamicLinker 语义与 fixture" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1230" y="285" width="390" height="75" as="geometry"/></mxCell><mxCell id="vm" value="&lt;b&gt;ProcessImageMemory&lt;/b&gt;&lt;br&gt;mmap / mprotect / COW；每进程 DSO instance" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECFEFF;strokeColor=#06B6D4;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1180" y="395" width="490" height="85" as="geometry"/></mxCell><mxCell id="uth" value="initial stack → user thread" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1260" y="515" width="330" height="50" as="geometry"/></mxCell>
      <mxCell id="core" value="&lt;b&gt;可复用的单一链接语义核心&lt;/b&gt;&lt;br&gt;&lt;br&gt;ELF / dynamic parser&lt;br&gt;依赖图与 scope&lt;br&gt;symbol / psABI relocation&lt;br&gt;init-fini plan&lt;br&gt;TargetAddr + LinkDomainId&lt;br&gt;ABI note + fixtures + oracle" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="735" y="155" width="330" height="350" as="geometry"/></mxCell>
      <mxCell id="artifact" value="&lt;b&gt;DsoArtifactCatalog（共享文件身份 / build-id / 只读 backing）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="1200" height="60" as="geometry"/></mxCell><mxCell id="inst1" value="当前：共享 system instance&lt;br&gt;代码和普通 RW 状态采用 RTOS 语义" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="755" width="500" height="70" as="geometry"/></mxCell><mxCell id="inst2" value="未来：每进程 instance&lt;br&gt;仅 RX/RO 页可共享；RW/GOT/TLS/ctor 私有" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="755" width="500" height="70" as="geometry"/></mxCell>
      <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="am" target="rs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="rs" target="fm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="fm" target="th"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="exec" target="ldso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="ldso" target="vm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="vm" target="uth"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="rs" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="复用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="ldso" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="artifact" target="inst1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="artifact" target="inst2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="n" value="迁移原则：现在把 frontend、memory backend、instance registry 做成适配器；不提前实现 Process、initial stack 或用户态解释器。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEFCE8;strokeColor=#EAB308;fontColor=#713F12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="1040" height="40" as="geometry"/></mxCell>
    </root></mxGraphModel>
