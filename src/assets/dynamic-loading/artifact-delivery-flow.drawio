  <diagram id="artifact-delivery-flow" name="7.3 Artifact delivery">
    <mxGraphModel dx="1800" dy="780" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="&lt;b&gt;BlueOS 动态应用：从 SDK 编译到可信运行时解析&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="45" as="geometry"/></mxCell>
      <mxCell id="z1" value="&lt;b&gt;构建&lt;/b&gt;" style="rounded=1;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="45" y="85" width="660" height="580" as="geometry"/></mxCell><mxCell id="z2" value="&lt;b&gt;检查与交付&lt;/b&gt;" style="rounded=1;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="745" y="85" width="550" height="580" as="geometry"/></mxCell><mxCell id="z3" value="&lt;b&gt;安装与运行&lt;/b&gt;" style="rounded=1;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1335" y="85" width="420" height="580" as="geometry"/></mxCell>
      <mxCell id="src" value="&lt;b&gt;应用 / librs / 私有 DSO 源码&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="165" width="290" height="65" as="geometry"/></mxCell><mxCell id="sdk" value="&lt;b&gt;统一 PIC SDK&lt;/b&gt;&lt;br&gt;共享 sysroot；blueos_scrt1/crti/crtn&lt;br&gt;libc.so link name；headers&lt;br&gt;librs.exports；ABI schema" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="445" y="140" width="215" height="120" as="geometry"/></mxCell><mxCell id="link" value="&lt;b&gt;clang + LLD 产物策略&lt;/b&gt;&lt;br&gt;PIC / PIE or -shared&lt;br&gt;NOW + RELRO + noexecstack" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="305" width="290" height="95" as="geometry"/></mxCell>
      <mxCell id="pie" value="main PIE&lt;br&gt;blueos_scrt1 + DT_NEEDED" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="175" height="70" as="geometry"/></mxCell><mxCell id="libc" value="libc.so.1&lt;br&gt;SONAME + exports" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#F97316;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="470" width="175" height="70" as="geometry"/></mxCell><mxCell id="dso" value="private *.so&lt;br&gt;SONAME + NEEDED" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="490" y="470" width="175" height="70" as="geometry"/></mxCell>
      <mxCell id="check" value="&lt;b&gt;Artifact Contract Checker&lt;/b&gt;&lt;br&gt;&lt;br&gt;ELF class / machine / ABI note&lt;br&gt;PT_INTERP policy / DT_NEEDED / SONAME&lt;br&gt;relocation whitelist / exports&lt;br&gt;无 TEXTREL / W+X；build-id&lt;br&gt;readelf + objdump + 自定义校验" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="815" y="155" width="410" height="230" as="geometry"/></mxCell><mxCell id="pkg" value="&lt;b&gt;签名应用包&lt;/b&gt;&lt;br&gt;manifest + app.elf + lib/*.so&lt;br&gt;hash / build-id / quotas / min ABI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8B5CF6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="455" width="270" height="100" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;签名系统 DSO&lt;/b&gt;&lt;br&gt;immutable libc.so.1&lt;br&gt;A/B 版本与 ABI 门禁" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#F97316;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="455" width="190" height="100" as="geometry"/></mxCell>
      <mxCell id="install" value="&lt;b&gt;安装期二次门禁&lt;/b&gt;&lt;br&gt;签名 / hash / target&lt;br&gt;依赖闭包 / min ABI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1390" y="155" width="310" height="100" as="geometry"/></mxCell><mxCell id="paths" value="&lt;b&gt;不可变安装位置&lt;/b&gt;&lt;br&gt;应用包仓库&lt;br&gt;/system/lib/&amp;lt;abi&amp;gt;/libc.so.1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1390" y="315" width="310" height="100" as="geometry"/></mxCell><mxCell id="resolver" value="&lt;b&gt;ApplicationArtifactResolver&lt;/b&gt;&lt;br&gt;固定 SONAME 映射&lt;br&gt;重验签名 / build-id / ABI note" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1390" y="475" width="310" height="100" as="geometry"/></mxCell>
