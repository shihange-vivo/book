      <mxCell id="n" value="构建期校验不能替代安装期与加载期校验：三道门禁分别防止错误产物、被篡改的包和运行时路径错配。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEFCE8;strokeColor=#EAB308;fontColor=#713F12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="1040" height="45" as="geometry"/></mxCell>
