      <mxCell id="exit" value="⑩ 等待全部线程 → 逆序 fini → 回收应用映像 → 释放 lease" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="565" y="785" width="900" height="55" as="geometry"/></mxCell>
      <mxCell id="note" value="&lt;b&gt;提交边界：&lt;/b&gt;publish 前失败可回滚本次映射与临时 lease；ctor 之后外部副作用不可自动撤销。末 lease 只有通过静默检查才卸载，否则缓存实例。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="875" width="1360" height="55" as="geometry"/></mxCell>
