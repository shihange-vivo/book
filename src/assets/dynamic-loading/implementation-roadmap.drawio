  <mxCell id="opt" value="&lt;b&gt;Phase 3 运行期装载基线&lt;/b&gt;　dlopen / dlsym / dlerror / dlclose　│　RTLD_NOW | RTLD_LOCAL&lt;br&gt;逻辑关闭、ThreadGroup 延迟回收　│　运行中立即卸载需要独立 UnloadSafe 协议" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="575" width="1380" height="65" as="geometry"/></mxCell><mxCell id="eo" value="Phase 3 子阶段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1618" y="485" as="sourcePoint"/><mxPoint x="1590" y="607" as="targetPoint"/></mxGeometry></mxCell>
