<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="implementation-roadmap" name="7.4 Implementation roadmap"><mxGraphModel dx="1800" dy="760" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
  <mxCell id="t" value="&lt;b&gt;BlueOS RTOS 动态加载分阶段实施路线&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="45" as="geometry"/></mxCell>
  <mxCell id="p0" value="&lt;b&gt;Phase 0&lt;/b&gt;&lt;br&gt;可信 static PIE 基线&lt;br&gt;&lt;br&gt;ELF 校验 / load bias / BSS&lt;br&gt;权限 / cache / rollback&lt;br&gt;fuzz corpus" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="285" height="190" as="geometry"/></mxCell><mxCell id="p05" value="&lt;b&gt;Phase 0.5&lt;/b&gt;&lt;br&gt;扩充 blueos_loader&lt;br&gt;&lt;br&gt;ImageLoader + DynamicLinker&lt;br&gt;LinkSession / TargetAddr&lt;br&gt;Relink differential oracle" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="395" y="145" width="300" height="190" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1&lt;/b&gt;&lt;br&gt;ARM32 Thumb 纵向 MVP&lt;br&gt;&lt;br&gt;app PIE → libc.so.1&lt;br&gt;ApplicationLoader / registry / lease&lt;br&gt;ApplicationStartInfo / emutls / exit" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="755" y="135" width="320" height="210" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2&lt;/b&gt;&lt;br&gt;多 DSO + 全架构&lt;br&gt;&lt;br&gt;libfoo → libc 依赖图&lt;br&gt;ARM hard-float / RV64 / A64 / RV32&lt;br&gt;SDK / ABI / debug 门禁" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1135" y="145" width="285" height="190" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3&lt;/b&gt;&lt;br&gt;运行期装载 + 产品化&lt;br&gt;&lt;br&gt;dlopen / dlsym / 逻辑关闭&lt;br&gt;签名 / OTA / allowlist&lt;br&gt;并发 / 诊断 / 性能" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1480" y="145" width="275" height="190" as="geometry"/></mxCell>
  <mxCell id="e1" value="装载正确" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="p0" target="p05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="边界冻结" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="p05" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="纵向闭环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="平台覆盖" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
  <mxCell id="g0" value="Gate 0&lt;br&gt;malformed ELF 与 mapping corpus 全部确定失败/成功" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="415" width="275" height="70" as="geometry"/></mxCell><mxCell id="g05" value="Gate 0.5&lt;br&gt;接口 ADR、拒绝清单、oracle 和体积基线冻结" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405" y="415" width="280" height="70" as="geometry"/></mxCell><mxCell id="g1" value="Gate 1&lt;br&gt;qemu_mps2_an385 上 libc 按需首装、复用、退出、重装" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="415" width="290" height="70" as="geometry"/></mxCell><mxCell id="g2" value="Gate 2&lt;br&gt;同一依赖 fixture 在六 target 绑定与 ctor 顺序一致" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#CFFAFE;strokeColor=#22D3EE;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1135" y="415" width="285" height="70" as="geometry"/></mxCell><mxCell id="g3" value="Gate 3&lt;br&gt;dl* 并发、OTA、压力、符号化与性能达标" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#4ADE80;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="415" width="275" height="70" as="geometry"/></mxCell>
