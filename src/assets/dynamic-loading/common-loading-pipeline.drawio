<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="common-loading-pipeline" name="3.1 Common pipeline">
    <mxGraphModel dx="1700" dy="700" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="&lt;b&gt;跨项目共同的动态加载主流程&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="45" as="geometry"/></mxCell>
      <mxCell id="input" value="&lt;b&gt;输入对象&lt;/b&gt;&lt;br&gt;artifact / package / module" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="240" width="180" height="100" as="geometry"/></mxCell>
      <mxCell id="p1" value="&lt;b&gt;① 准入与映射准备&lt;/b&gt;&lt;br&gt;&lt;br&gt;准入：格式 / 架构 / ABI / 来源 / 配额&lt;br&gt;预扫描：segment / section / 总布局&lt;br&gt;reserve：未发布目标内存&lt;br&gt;copy / zero：复制内容并清零 BSS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="160" width="330" height="260" as="geometry"/></mxCell>
      <mxCell id="p2" value="&lt;b&gt;② 依赖与链接&lt;/b&gt;&lt;br&gt;&lt;br&gt;runtime metadata：dynsym / reloc / init&lt;br&gt;dependency closure：发现、去重、建图&lt;br&gt;scope：冻结符号查找范围&lt;br&gt;relocation：relative → data/GOT → PLT" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="330" height="260" as="geometry"/></mxCell>
      <mxCell id="p3" value="&lt;b&gt;③ 收口、发布与启动&lt;/b&gt;&lt;br&gt;&lt;br&gt;seal：最终权限 / RELRO / cache sync&lt;br&gt;publish：原子加入 registry / namespace&lt;br&gt;initialize：依赖优先执行 ctor&lt;br&gt;enter：调用入口或创建执行线程" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="330" height="260" as="geometry"/></mxCell>
      <mxCell id="p4" value="&lt;b&gt;④ 退出与回收&lt;/b&gt;&lt;br&gt;&lt;br&gt;停止新引用&lt;br&gt;等待线程 / 回调 / TLS 静默&lt;br&gt;逆序 fini&lt;br&gt;unpublish / free" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="160" width="275" height="260" as="geometry"/></mxCell>
      <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;" edge="1" parent="1" source="input" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2.5;endArrow=block;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="rollback" value="&lt;b&gt;准备期失败：回滚未发布资源&lt;/b&gt;&lt;br&gt;映射、临时依赖和私有元数据可撤销；publish 后进入实例生命周期" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0C4A6E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="480" width="1070" height="70" as="geometry"/></mxCell>
      <mxCell id="optional" value="纯装载器可能裁剪 dependency / scope；ET_REL 模块可能按 section 装入，但保留下来的阶段仍不能颠倒。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;" vertex="1" parent="1"><mxGeometry x="365" y="585" width="970" height="55" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
