<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="thread-group-lifecycle" name="5.3 ThreadGroup lifecycle"><mxGraphModel dx="1750" dy="700" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1750" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
  <mxCell id="t" value="&lt;b&gt;ThreadGroup 资源状态、所有权与失败路径&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1670" height="45" as="geometry"/></mxCell>
  <mxCell id="s1" value="&lt;b&gt;Loading&lt;/b&gt;&lt;br&gt;ApplicationState: Loading&lt;br&gt;link / seal / init；业务入口未开放" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="300" height="105" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;ApplicationState: Running&lt;br&gt;主线程 + 子线程；成员引用保活" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="300" height="105" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Draining&lt;/b&gt;&lt;br&gt;ApplicationState: Stopping / Failed&lt;br&gt;禁止新线程；等待退出；逆序 fini" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="920" y="180" width="300" height="105" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Reaped&lt;/b&gt;&lt;br&gt;ApplicationState: Terminated / Failed&lt;br&gt;unpublish / free / release lease" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1340" y="180" width="300" height="105" as="geometry"/></mxCell>
  <mxCell id="e1" value="init complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="main 返回 / exit / abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="最后线程退出 + fini" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=2;endArrow=block;html=1;fontSize=13;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
  <mxCell id="rb" value="&lt;b&gt;准备期失败&lt;/b&gt;&lt;br&gt;逆序释放临时 mapping / lease；从未对运行线程可见" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="405" width="430" height="75" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;ctor 失败&lt;/b&gt;&lt;br&gt;Loading → Failed → Draining；外部副作用不承诺回滚" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="405" width="450" height="75" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;系统 DSO 末 lease&lt;/b&gt;&lt;br&gt;进入 Quiescing：证明无线程、回调、TLS destructor、atexit、函数指针和依赖边后才卸载；否则缓存 Ready 实例" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="405" width="620" height="75" as="geometry"/></mxCell>
  <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s1" target="rb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s1" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;html=1;" edge="1" parent="1" source="s4" target="q"><mxGeometry relative="1" as="geometry"/></mxCell>
  <mxCell id="n" value="资源寿命：应用 main/private DSO region 由 ThreadGroup 持有；系统 libc 映像由 registry 持有，ThreadGroup 只持 SystemDsoLease。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="1150" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
