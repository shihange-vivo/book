  <diagram id="blueos-layered-architecture" name="5.2 BlueOS architecture">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="&lt;b&gt;BlueOS RTOS 动态加载分层与稳定边界&lt;/b&gt;" style="text;html=1;align=center;fontSize=27;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="45" as="geometry"/></mxCell>
      <mxCell id="app" value="&lt;b&gt;动态应用（shell / hello…）&lt;/b&gt;&lt;br&gt;ET_DYN / PIE · scrt1 + 私有 libfoo.so" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="520" y="95" width="300" height="80" as="geometry"/></mxCell>
      <mxCell id="libc" value="&lt;b&gt;/system/lib/&amp;lt;abi&amp;gt;/libc.so.1&lt;/b&gt;&lt;br&gt;librs + blueos_scal_swi" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="860" y="95" width="300" height="80" as="geometry"/></mxCell>
      <mxCell id="kernel" value="" style="rounded=1;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="1140" height="650" as="geometry"/></mxCell>
      <mxCell id="kt" value="&lt;b&gt;BlueOS 内核（共享特权地址空间）&lt;/b&gt;" style="text;html=1;align=left;fontSize=20;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="85" y="255" width="600" height="35" as="geometry"/></mxCell>
      <mxCell id="manager" value="&lt;b&gt;ApplicationManager&lt;/b&gt;&lt;br&gt;/kernel/application/manager.rs&lt;br&gt;统一准入 · handle · state · 后端分派&lt;br&gt;不参与线程调度" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="305" width="330" height="115" as="geometry"/></mxCell>
      <mxCell id="backend" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=2;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="490" y="290" width="690" height="380" as="geometry"/></mxCell>
      <mxCell id="bt1" value="/kernel/application/thread_group/" style="text;html=1;align=center;fontSize=14;fontColor=#475569;fontStyle=1;" vertex="1" parent="backend"><mxGeometry x="233" y="25" width="224" height="20" as="geometry"/></mxCell>
      <mxCell id="bt2" value="后端（当前唯一实现）" style="text;html=1;align=center;fontSize=12;fontColor=#64748B;" vertex="1" parent="backend"><mxGeometry x="245" y="44" width="200" height="18" as="geometry"/></mxCell>
      <mxCell id="loader" value="&lt;b&gt;ApplicationLoader&lt;/b&gt;（loader.rs）&lt;br&gt;启动期链接前端&lt;br&gt;调用 DynamicLinker · registry 协调" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#A78BFA;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="350" width="320" height="120" as="geometry"/></mxCell>
      <mxCell id="registry" value="&lt;b&gt;SystemDsoRegistry&lt;/b&gt;（system_dso.rs）&lt;br&gt;artifact 目录 + 运行实例表&lt;br&gt;按需首装 · lease · 静默卸载" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFEDD5;strokeColor=#FB923C;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="350" width="300" height="120" as="geometry"/></mxCell>
      <mxCell id="adapters" value="&lt;b&gt;adapters/&lt;/b&gt;：VfsElfReader · SystemLibraryPaths（application/ 通用）&lt;br&gt;FlatImageMemory · ArtifactResolver（thread_group/ 模型特有）· cache → arch/*/cache.rs" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECFEFF;strokeColor=#06B6D4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="545" width="670" height="80" as="geometry"/></mxCell>
      <mxCell id="core" value="" style="rounded=1;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1250" y="300" width="330" height="470" as="geometry"/></mxCell>
      <mxCell id="ct1" value="&lt;b&gt;blueos_loader rlib&lt;/b&gt;　/loader/" style="text;html=1;align=left;fontSize=15;fontColor=#0F172A;" vertex="1" parent="core"><mxGeometry x="12" y="28" width="300" height="25" as="geometry"/></mxCell>
      <mxCell id="ct2" value="独立于内核的 crate，静态编入内核" style="text;html=1;align=left;fontSize=12;fontColor=#64748B;" vertex="1" parent="core"><mxGeometry x="12" y="52" width="306" height="18" as="geometry"/></mxCell>
      <mxCell id="image" value="&lt;b&gt;ImageLoader&lt;/b&gt;　image/&lt;br&gt;单 ELF：admit → 布局 → 复制清零&lt;br&gt;S0–S4 分阶段映像" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=2;fontSize=13;" vertex="1" parent="core"><mxGeometry x="18" y="75" width="294" height="95" as="geometry"/></mxCell>
      <mxCell id="dynlink" value="&lt;b&gt;DynamicLinker&lt;/b&gt;　dynamic_linker/&lt;br&gt;依赖图 · scope · 符号解析&lt;br&gt;relocation · LinkSession 事务回滚" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#A78BFA;strokeWidth=2;fontSize=13;" vertex="1" parent="core"><mxGeometry x="18" y="185" width="294" height="95" as="geometry"/></mxCell>
      <mxCell id="traits" value="&lt;b&gt;核心接口（trait）&lt;/b&gt;&lt;br&gt;ElfReader（reader.rs）&lt;br&gt;ImageMemory（memory.rs）&lt;br&gt;CodeCache（memory.rs）&lt;br&gt;ArchRelocator（relocation/arch/）&lt;br&gt;&lt;i&gt;crate 内实现&lt;/i&gt;&lt;br&gt;Resolver：内核 adapters 实现" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=13;" vertex="1" parent="core"><mxGeometry x="18" y="295" width="294" height="175" as="geometry"/></mxCell>
      <mxCell id="services" value="&lt;b&gt;内核稳定服务边界&lt;/b&gt;　VFS　│　allocator　│　MPU/MMU　│　scheduler + thread　│　版本化 syscall ABI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#4ADE80;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="155" y="790" width="985" height="70" as="geometry"/></mxCell>
      <mxCell id="note" value="blueos_loader 不依赖内核对象；应用与 DSO 只经 libc.so.1 的 SWI 使用内核 ABI，链接核心所需能力由内核 adapters 以 trait 提供。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FEFCE8;strokeColor=#EAB308;fontColor=#713F12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="900" width="920" height="45" as="geometry"/></mxCell>
      <mxCell id="la4" value="分派" style="text;html=1;align=center;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="448" y="344" width="44" height="16" as="geometry"/></mxCell>
      <mxCell id="la5" value="lease" style="text;html=1;align=center;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="830" y="428" width="30" height="14" as="geometry"/></mxCell>
      <mxCell id="la6" value="调用 link()" style="text;html=1;align=center;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1185" y="390" width="60" height="16" as="geometry"/></mxCell>
      <mxCell id="la7" value="trait 回调" style="text;html=1;align=center;fontSize=12;fontColor=#0891B2;" vertex="1" parent="1"><mxGeometry x="1191" y="590" width="54" height="16" as="geometry"/></mxCell>
      <mxCell id="la1" value="ApplicationLaunch syscall" style="text;html=1;align=center;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="470" y="249" width="150" height="16" as="geometry"/></mxCell>
      <mxCell id="la8" value="boot 自举：内核直呼 launch() 装载 shell（唯一函数调用例外）" style="text;html=1;align=center;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="100" y="442" width="330" height="16" as="geometry"/></mxCell>
